<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Packing List - Kosmos</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body>

    <!-- Navigation Bar -->
    <%- include('../partials/navbar') %>

    <!-- Main Content -->
    <div class="container mt-4">
        <div class="row">
            <!-- Trip Overview -->
            <div class="col-md-3">
                <%- include('../partials/trip_tile2') %>
            </div>

            <!-- Add Item Section -->
            <div class="col-md-4">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">Add Item</h5>
                            <button type="button" class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#packingHelpModal" title="How do I add items?">
                                <i class="bi bi-question-circle"></i>
                            </button>
                        </div>
                        <form action="/trips/<%= trip.trip_id %>/packing_list/add" method="POST">
                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <input type="text" class="form-control" name="item_name" required>
                            </div>
                            <button type="submit" class="btn btn-light">Add Item</button>
                        </form>
                    </div>
                </div>

                <div class="card bg-primary text-white mt-4">
                    <div class="card-body">
                        <h5 class="card-title">Import Items</h5>
                        <p class="small mb-2">Paste a list suggested elsewhere and add its items here.</p>
                        <a href="/trips/<%= trip.trip_id %>/packing_list/import" class="btn btn-light">Import from Chat</a>
                    </div>
                </div>
            </div>

            <!-- Packing List Section -->
            <div class="col-md-4">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <h5 class="card-title">Packing List</h5>
                        <ul class="list-group packing-list-items">
                            <% packingList.forEach(item => { %>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        <input type="checkbox" class="form-check-input me-2 item-checkbox" data-item-id="<%= item.item_id %>" <%= item.packed ? 'checked' : '' %> >
                                        <span class="me-2 item-name" id="display-name-<%= item.item_id %>"><%= item.item_name %></span>
                                        <form action="/trips/<%= trip.trip_id %>/packing_list/edit/<%= item.item_id %>" method="POST" class="d-none flex-grow-1 align-items-center" id="edit-form-<%= item.item_id %>" style="display: flex;">
                                            <input type="text" name="item_name" class="form-control form-control-sm me-2 flex-grow-1" value="<%= item.item_name %>" required>
                                            <button type="submit" class="btn btn-sm btn-success">Save</button>
                                        </form>
                                    </div>
                                    <div>
                                        <% const shopLink = affiliates.amazonSearch(item.item_name); %>
                                        <% if (shopLink) { %>
                                            <a href="<%= shopLink %>" target="_blank" rel="sponsored noopener noreferrer" class="btn btn-sm btn-light" title="Shop for this on Amazon">🛒</a>
                                        <% } %>
                                        <button class="btn btn-sm btn-light" onclick="toggleEditForm(<%= item.item_id %>)">✏️</button>
                                        <form action="/trips/<%= trip.trip_id %>/packing_list/delete/<%= item.item_id %>" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-danger">🗑️</button>
                                        </form>
                                    </div>
                                </li>
                            <% }); %>
                        </ul>
                        <% if (affiliates.amazonSearch('x')) { %>
                            <p class="small mt-2 mb-0 opacity-75">As an Amazon Associate I earn from qualifying purchases.</p>
                        <% } %>

                        <div class="progress mt-3">
                            <div 
                                class="progress-bar bg-success" 
                                role="progressbar" 
                                style="width: <%= progress %>%;" 
                                aria-valuenow="<%= progress %>" 
                                aria-valuemin="0" 
                                aria-valuemax="100"
                            >
                                <%= progress %>% Packed
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Help Modal -->
    <div class="modal fade" id="packingHelpModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Adding to your packing list</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h6>Add Item</h6>
                    <p>Type a single item and click "Add Item" to drop it straight onto the list.</p>
                    <h6>Import Items</h6>
                    <p class="mb-0">Have a packing list from somewhere else - an AI assistant's suggestions, notes,
                        whatever? Click "Import from Chat" and paste the whole thing in. Claude will split it into
                        individual items, which you can review, edit or uncheck before anything is added.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Got it</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('.item-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                const itemId = this.getAttribute('data-item-id');
                const packed = this.checked;

                fetch(`/trips/<%= trip.trip_id %>/packing_list/update/${itemId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ packed })
                })
                .then(response => response.json())
                .then(data => {
                    console.log("✅ Item updated:", data);
                    location.reload();  // Reload page to reflect progress
                })
                .catch(err => console.error("❌ Error updating item:", err));
            });
        });
    </script>
    <script>
        function toggleEditForm(itemId) {
            const displaySpan = document.getElementById(`display-name-${itemId}`);
            const editForm = document.getElementById(`edit-form-${itemId}`);
            displaySpan.classList.toggle('d-none');
            editForm.classList.toggle('d-none');
        }
    </script>
</body>
</html>