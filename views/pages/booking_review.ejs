<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Review Booking - Kosmos</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <script src="https://maps.googleapis.com/maps/api/js?key=<%= apiKey %>&libraries=places"></script>
</head>

<body>

    <!-- Navigation Bar -->
    <%- include('../partials/navbar') %>

    <div class="container mt-4" style="max-width: 700px;">
        <h3>Review Extracted Booking</h3>
        <p class="text-muted">
            Pulled from <strong><%= originalName %></strong> automatically - check everything below before saving.
            Nothing has been added to <%= trip.trip_name %> yet.
        </p>

        <% if (booking.confirmation_number) { %>
            <div class="alert alert-info">
                Confirmation number found in document: <strong><%= booking.confirmation_number %></strong>
                (not currently saved as its own field, noted here for your reference)
            </div>
        <% } %>

        <div class="card p-3">
            <form action="/trips/<%= trip.trip_id %>/bookings/add-extracted" method="POST">
                <input type="hidden" name="file_name" value="<%= fileName %>">
                <input type="hidden" name="original_name" value="<%= originalName %>">
                <input type="hidden" name="extracted_data" value="<%= extractedData %>">

                <div class="mb-3">
                    <label for="accommodation_type" class="form-label">Accommodation Type</label>
                    <select class="form-select" id="accommodation_type" name="accommodation_type" required>
                        <option value="">Select Type</option>
                        <% ['Transportation', 'Lodging', 'Activity', 'Food'].forEach(function(type) { %>
                            <option value="<%= type %>" <%= booking.accommodation_type === type ? 'selected' : '' %>><%= type %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="vendor_name" class="form-label">Vendor Name</label>
                    <input type="text" class="form-control" id="vendor_name" name="vendor_name" value="<%= booking.vendor_name || '' %>" required>
                </div>

                <div class="row mb-3">
                    <div class="col">
                        <label for="start_date" class="form-label">Start Date</label>
                        <input type="date" class="form-control" id="start_date" name="start_date" value="<%= booking.start_date || '' %>" required>
                    </div>
                    <div class="col">
                        <label for="end_date" class="form-label">End Date</label>
                        <input type="date" class="form-control" id="end_date" name="end_date" value="<%= booking.end_date || '' %>">
                    </div>
                </div>

                <div class="mb-3">
                    <label for="booking_link" class="form-label">Booking Link (Optional)</label>
                    <input type="url" class="form-control" id="booking_link" name="booking_link" placeholder="https://example.com/booking" value="<%= booking.booking_link || '' %>">
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input type="text" class="form-control" id="location" name="location" placeholder="Enter a location" value="<%= booking.location || '' %>">
                </div>

                <div class="row mb-3">
                    <div class="col">
                        <label for="start_location" class="form-label">Start Location</label>
                        <input type="text" class="form-control" id="start_location" name="start_location" placeholder="Enter start location" value="<%= booking.start_location || '' %>">
                    </div>
                    <div class="col">
                        <label for="end_location" class="form-label">End Location</label>
                        <input type="text" class="form-control" id="end_location" name="end_location" placeholder="Enter end location" value="<%= booking.end_location || '' %>">
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary flex-grow-1">Save Booking</button>
                    <a href="/trips/<%= trip.trip_id %>/bookings" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <script>
        function initAutocomplete() {
            if (!window.google || !google.maps || !google.maps.places) return;
            new google.maps.places.Autocomplete(document.getElementById('location'));
            new google.maps.places.Autocomplete(document.getElementById('start_location'));
            new google.maps.places.Autocomplete(document.getElementById('end_location'));
        }
        google.maps.event.addDomListener(window, 'load', initAutocomplete);
    </script>
</body>
</html>
