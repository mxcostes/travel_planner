<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Import Itinerary - Kosmos</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <!-- Navigation Bar -->
    <%- include('../partials/navbar') %>

    <div class="container mt-4" style="max-width: 700px;">
        <h3>Import itinerary from chat</h3>
        <p class="text-muted">
            Paste a day-by-day itinerary you drafted elsewhere - a planning chat, an email, notes, whatever - and
            Claude will pull out the individual activities so you can review and add them to
            <strong><%= trip.trip_name %></strong>.
        </p>

        <form method="POST" action="/trips/<%= trip.trip_id %>/itinerary/import">
            <textarea class="form-control mb-3" name="planText" rows="16"
                placeholder="Day 1 - Tokyo&#10;9:00am - Arrive Narita, train to Shinjuku&#10;1:00pm - Lunch at Ichiran ramen&#10;3:00pm - Explore Shinjuku Gyoen&#10;&#10;Day 2 - Tokyo&#10;..."
                required></textarea>
            <div class="d-flex gap-2 mb-5">
                <button type="submit" class="btn btn-primary flex-grow-1">Extract Activities</button>
                <a href="/trips/<%= trip.trip_id %>/itinerary" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
